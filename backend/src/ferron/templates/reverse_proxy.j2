{# template for reverse proxying #}
{%- extends "_base_virtual_host.j2" -%}

{%- block body -%}

{%- block proxy_location %}
    proxy {
        {%- if use_unix_socket and unix_socket_path is defined %}
            upstream "{{ backend_url }}" {
                unix {{ unix_socket_path }}
            }
        {% else %}
            upstream "{{ backend_url }}"
        {% endif -%}
        {%- if preserve_host_header %}
            request_header Host "{% raw %}{{request.header.host}}{% endraw %}"
        {% endif %}
    }

{%- endblock -%}

{% include "_cache_template.j2" -%}


{%- endblock -%}
