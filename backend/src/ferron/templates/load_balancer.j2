{# template for load balancing #}
{%- extends "reverse_proxy.j2" -%}

{%- block proxy_location -%}

proxy {
    {% for backend_url in backend_urls %}
        upstream "{{ backend_url }}"
    {%- endfor %}

    {%  if lb_health_check %}
        circuit_breaker {
            {% if lb_health_check_max_fails %}
                max_fails {{ lb_health_check_max_fails }}
            {% endif -%}
            {% if lb_health_check_window %}
                window "{{ lb_health_check_window }}"
            {% endif -%}
        }
    {% endif -%}
        {%- if preserve_host_header %}
            request_header Host "{% raw %}{{request.header.host}}{% endraw %}"
        {% endif %}
    }
{%- endblock %}
