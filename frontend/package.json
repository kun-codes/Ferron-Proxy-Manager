{
    "name": "frontend",
    "private": true,
    "version": "0.1.0-alpha",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint .",
        "generate:types": "openapi-typescript http://localhost:8000/openapi.json -o src/lib/api/types.ts --enum=true --enum-values=true --make-paths-enum=true --dedupe-enums=true"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^10.0.1",
        "@internationalized/date": "^3.12.4",
        "@lucide/svelte": "^1.56.0",
        "@sveltejs/adapter-auto": "^7.0.1",
        "@sveltejs/adapter-node": "^5.5.7",
        "@sveltejs/kit": "^2.70.3",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/table-core": "^8.21.3",
        "@types/node": "^24.19.2",
        "bits-ui": "^2.19.5",
        "clsx": "^2.1.1",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.23.1",
        "globals": "^17.13.0",
        "openapi-typescript": "^7.13.0",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "svelte": "^5.57.2",
        "svelte-check": "^4.7.6",
        "svelte-sonner": "^1.2.1",
        "tailwind-merge": "^3.7.0",
        "tailwind-variants": "^3.3.1",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4"
    },
    "dependencies": {
        "cookie": "^1.1.1",
        "mode-watcher": "^1.1.0",
        "openapi-fetch": "^0.17.0"
    }
}
